# ─────────────────────────────────────────────────────────────
# Public — exposed to client bundle (NEXT_PUBLIC_*)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WEDDING_DATE=2026-05-23

# WhatsApp d'entraide (lien d'invitation au groupe — public)
NEXT_PUBLIC_WHATSAPP_URL=

# Supabase — public client config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Server-only secrets — NEVER prefix with NEXT_PUBLIC_
# ─────────────────────────────────────────────────────────────
# Supabase service_role (full access — server only)
SUPABASE_SERVICE_ROLE_KEY=

# Lien d'invitation global — slug secret pour /invite/[slug] (auto-inscription).
# Génère avec : openssl rand -hex 24
# Le lien expire automatiquement le 25 mai 2026 (cf. lib/invite.ts).
GLOBAL_INVITE_SLUG=

# Direct Postgres connection (used by scripts/migrate.ts and rate limiter via service_role client)
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# Cagnotte — Wise (read-only balance polling, no SCA in v1)
# ─────────────────────────────────────────────────────────────
WISE_API_TOKEN=
WISE_PROFILE_ID=
WISE_BALANCE_ID=

# Webhook Wise — clé publique RSA de PROD pour vérifier X-Signature-SHA256.
# Récupérée depuis https://docs.wise.com/guides/developer/webhooks/event-handling
# PEM multi-ligne ; sur Vercel coller le PEM tel quel (les sauts de ligne
# sont conservés dans la valeur de la variable). Cf. docs/04-wise-webhook.md.
WISE_WEBHOOK_PUBLIC_KEY_PEM=

# Bloc affiché sur /cagnotte
CAGNOTTE_IBAN=
CAGNOTTE_BIC=
CAGNOTTE_RECIPIENT_NAME=
CAGNOTTE_REFERENCE=CADEAU-BA
CAGNOTTE_LYDIA_URL=
# Wise tag (sans le @) — affiché sous les coordonnées de virement
CAGNOTTE_WISETAG=

# ─────────────────────────────────────────────────────────────
# Email — OPTIONAL (Resend). If unset, magic links rely on Supabase
# default email and digests no-op (logged to console).
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Gmail App Password (16 chars, 2FA requis) — utilisé par Supabase Auth SMTP
# pour envoyer le magic link. Référencé dans supabase/config.toml.
GMAIL_APP_PASSWORD=
# Recipients of the daily digest — ORGANIZERS only, NEVER the couple.
# CSV. Mettre par ex: cfrerebeau@gmail.com,remy.frerebeau@gmail.com
ORGANIZER_NOTIFICATION_EMAILS=

# ─────────────────────────────────────────────────────────────
# Storage (Supabase)
# ─────────────────────────────────────────────────────────────
SUPABASE_PHOTOS_BUCKET=photos-souvenirs

# ─────────────────────────────────────────────────────────────
# Crypto — generate locally, never commit real values
# ─────────────────────────────────────────────────────────────
# 32+ random bytes hex — `openssl rand -hex 32`
IP_HASH_SALT=
SESSION_COOKIE_SECRET=

# ─────────────────────────────────────────────────────────────
# Cron — token Vercel Cron envoie via Authorization header
# ─────────────────────────────────────────────────────────────
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# Blocklist — emails du couple. CSV. Lus par scripts/seed-blocked.ts
# ou directement par la migration 0002_seed_blocked_guests.sql.
# ─────────────────────────────────────────────────────────────
BLOCKED_EMAILS=
